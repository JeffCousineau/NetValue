@inject HouseholdSession Store
@inject NavigationManager Navigation
<section class="accounts-panel settings-panel">
    <h2>Household members</h2>
    <p>Members can view, edit, and export household data. Owners can also restore backups and manage access.</p>
    @if (!string.IsNullOrEmpty(error)) { <div class="error" role="alert">@error</div> }
    @foreach (var member in members)
    {
        <div class="member-row"><strong>@member.Name · @member.Role</strong>
            @if (member.UserId != Store.UserId)
            {
                <select aria-label="@($"Role for {member.Name}")" value="@member.Role" @onchange="args => ChangeRole(member.UserId, args)"><option value="Member">Member</option><option value="Owner">Owner</option></select>
                <button class="subtle danger" @onclick="() => pendingRemoval = member">Remove access</button>
            }
        </div>
    }
    @if (pendingRemoval is { } removal)
    {
        <div class="delete-confirm"><p>Remove @removal.Name from this household?</p><button class="primary danger-button" @onclick="Remove">Remove access</button><button class="subtle" @onclick="() => pendingRemoval = null">Cancel</button></div>
    }
    <h3>Invite someone</h3>
    <p>Create a link and send it to the person you want to invite. They’ll sign in with Microsoft and join as a Member.</p>
    <p>Anyone with the link can accept it once. It expires after seven days.</p>
    <button class="primary" @onclick="Invite">Create invitation link</button>
    @if (!string.IsNullOrEmpty(inviteLink))
    {
        <label for="invite-link">Copy and share this link</label><input id="invite-link" style="width:100%" readonly value="@inviteLink" />
    }
    @foreach (var invitation in invitations)
    {
        <div class="member-row"><span>Pending invitation · expires @invitation.ExpiresUtc.ToString("yyyy-MM-dd") UTC</span><button class="subtle danger" @onclick="() => Revoke(invitation.Id)">Revoke invitation</button></div>
    }
</section>
@code {
    private List<MemberInfo> members = [];
    private List<HouseholdInvitation> invitations = [];
    private MemberInfo? pendingRemoval;
    private string inviteLink = "";
    private string error = "";
    protected override void OnInitialized() => Run(Refresh);
    private void Refresh() { members = Store.Members(); invitations = Store.Invitations(); }
    private void Run(Action action)
    {
        error = "";
        try { action(); }
        catch (UnauthorizedAccessException) { error = "Only a household owner can manage access. Reload the page if your access changed."; }
        catch (Exception exception) when (exception is InvalidDataException or InvalidOperationException) { error = exception.Message; }
        catch (Exception) { error = "Unable to update household access. Please try again."; }
    }
    private void Invite() => Run(() => { inviteLink = Navigation.BaseUri + "?invite=" + Store.CreateInvitation(); Refresh(); });
    private void ChangeRole(Guid userId, ChangeEventArgs args) => Run(() => { if (!Enum.TryParse<HouseholdRole>(args.Value?.ToString(), out var role)) return; Store.SetMemberRole(userId, role); Refresh(); });
    private void Revoke(Guid id) => Run(() => { Store.RevokeInvitation(id); inviteLink = ""; Refresh(); });
    private void Remove() => Run(() => { if (pendingRemoval is null) return; Store.RemoveMember(pendingRemoval.UserId); pendingRemoval = null; Refresh(); });
}
